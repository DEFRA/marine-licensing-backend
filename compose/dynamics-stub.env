# Dynamics contact details ("who is the exemption for") served by marine-licensing-api-stub.
# Kept out of compose.yml because compose's ${VAR:-default} interpolation mangles the
# {{contactId}} placeholder. Note `$$select` - compose interpolates `$` here too, so it is escaped.
# To use a real Dynamics environment, edit the values below (see README).
DYNAMICS_ENABLED=true
DYNAMICS_TOKEN_URL=http://marine-licensing-api-stub:3002/dynamics/oauth2/v2.0/token
DYNAMICS_API_CONTACT_DETAILS_URL=http://marine-licensing-api-stub:3002/dynamics/api/data/v9.2/contacts({{contactId}})?$$select=fullname
DYNAMICS_API_CONTACT_DETAILS_BASE_URL=http://marine-licensing-api-stub:3002/dynamics/api/data/v9.2
DYNAMICS_CLIENT_ID_CONTACT_DETAILS=stub-client-id
DYNAMICS_CLIENT_SECRET_CONTACT_DETAILS=stub-client-secret
DYNAMICS_SCOPE_CONTACT_DETAILS=http://marine-licensing-api-stub:3002/.default
