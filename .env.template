DEFRA_ID_JWKS_URI=https://dcidmtest.b2clogin.com/dcidmtest.onmicrosoft.com/b2c_1a_cui_cpdev_signupsignin/discovery/v2.0/keys

ENTRA_ID_JWKS_URI=https://login.microsoftonline.com/common/discovery/keys

BACKEND_GATEWAY_URL=http://localhost:3001

NOTIFY_API_KEY=

# To enable both integrations with Dynamics (send exemption on submission, and get user contact details)
# The values below point both integrations at the local marine-licensing-api-stub, so they can be
# tested without access to a real Dynamics environment.
# Under `docker compose up` the equivalent values in compose/dynamics-stub.env take precedence
# (container hostnames).
DYNAMICS_ENABLED=true

# For getting an auth token for exemptions endpoint.
# Placeholders only - the stub token endpoint accepts anything. Replace with real
# credentials (not blanks) if you point DYNAMICS_TOKEN_URL at Microsoft.
DYNAMICS_CLIENT_ID=stub-client-id
DYNAMICS_CLIENT_SECRET=stub-client-secret

# Submission flows. DYNAMICS_API_URL is a base - the backend appends /exemptions to it.
DYNAMICS_API_URL=http://localhost:3002/dynamics/flows
DYNAMICS_API_WITHDRAW_URL=http://localhost:3002/dynamics/flows/exemptions/withdraw
DYNAMICS_API_UPDATE_EXEMPTION_URL=http://localhost:3002/dynamics/flows/exemptions/update
DYNAMICS_MARINE_LICENCE_API_URL=http://localhost:3002/dynamics/flows/marine-licences

# Stubbed by marine-licensing-api-stub. Comment out to use the real Microsoft token endpoint.
DYNAMICS_TOKEN_URL=http://localhost:3002/dynamics/oauth2/v2.0/token

# For getting an auth token for contact details endpoint
DYNAMICS_CLIENT_ID_CONTACT_DETAILS=stub-client-id
DYNAMICS_CLIENT_SECRET_CONTACT_DETAILS=stub-client-secret
DYNAMICS_API_CONTACT_DETAILS_URL=http://localhost:3002/dynamics/api/data/v9.2/contacts({{contactId}})?$select=fullname
DYNAMICS_API_CONTACT_DETAILS_BASE_URL=http://localhost:3002/dynamics/api/data/v9.2
DYNAMICS_SCOPE_CONTACT_DETAILS=http://localhost:3002/.default

# Real Dynamics values (requires credentials and network access). The submission flow URLs are
# Power Automate endpoints - get the current ones from CDP rather than guessing.
# DYNAMICS_TOKEN_URL=https://login.microsoftonline.com/6f504113-6b64-43f2-ade9-242e05780007/oauth2/v2.0/token
# DYNAMICS_API_CONTACT_DETAILS_URL=https://marinelicensingdev.crm11.dynamics.com/api/data/v9.2/contacts({{contactId}})?$select=fullname
# DYNAMICS_API_CONTACT_DETAILS_BASE_URL=https://marinelicensingdev.crm11.dynamics.com/api/data/v9.2
# DYNAMICS_SCOPE_CONTACT_DETAILS=https://marinelicensingdev.crm11.dynamics.com/.default

# Integration with Explore Marine Plans
EMP_ENABLED=false
EMP_API_URL=
EMP_API_KEY=

# Marine plan policy (ArcGIS) lookups
# By default `docker compose up` points this at the local marine-licensing-api-stub container.
# Uncomment to hit the real DEFRA ArcGIS FeatureServer instead when running under docker compose:
ARCGIS_FEATURE_SERVER_URL=https://services.arcgis.com/JJzESW51TqeY9uat/ArcGIS/rest/services/PolicyData_MDP/FeatureServer/0
